<!DOCTYPE html>
<html lang="en">
  {{> head}}

  <body>
    <style>
      /* ---- landing-only layout (page-scoped; base tokens/components come from
             the bundled docs.css) ---- */
      .lp-wrap { max-width: 1080px; margin: 0 auto; padding: 0 var(--sp-5); }
      .lp-topbar { background: #0B0D11; border-bottom: 0; color: #E8ECF3; }
      .lp-topbar .sk-brand, .lp-topbar .sk-wordmark { color: #F4F7FB; }
      .lp-topbar .sk-ver { background: #14181F; border-color: #2F3946; color: #A9B4C4; }
      .lp-topbar .sk-topnav a { color: #A9B4C4; }
      .lp-topbar .sk-topnav a:hover { color: #F4F7FB; }

      .lp-hero {
        position: relative; overflow: hidden;
        background: #0B0D11; color: #E8ECF3;
        border-bottom: 1px solid var(--sk-border);
      }
      .lp-hero::before {
        content: ""; position: absolute; inset: -20% -10%;
        background:
          linear-gradient(115deg, transparent 46%, rgba(78,166,247,0.16) 47%, transparent 48%),
          linear-gradient(115deg, transparent 60%, rgba(78,166,247,0.10) 61%, transparent 62%),
          radial-gradient(1000px 500px at 78% -10%, rgba(78,166,247,0.18), transparent 60%);
        pointer-events: none;
      }
      .lp-hero-inner { position: relative; padding: 88px 0 96px; max-width: 720px; }
      .lp-eyebrow {
        font-family: var(--sk-font-mono); font-size: var(--fs-xs); letter-spacing: 0.14em;
        text-transform: uppercase; color: #7FBDF6; margin-bottom: var(--sp-4);
      }
      .lp-h1 {
        font-family: var(--sk-font-display); font-weight: 600; font-size: var(--fs-display);
        line-height: 1.05; letter-spacing: -0.03em; margin: 0 0 var(--sp-4); color: #F4F7FB;
      }
      .lp-h1 .carve { color: #4EA6F7; }
      .lp-sub { font-size: 1.25rem; line-height: 1.55; color: #A9B4C4; margin: 0 0 var(--sp-6); max-width: 620px; }
      .lp-cta { display: flex; gap: var(--sp-3); flex-wrap: wrap; align-items: center; }
      .lp-cta .sk-btn-ghost { color: #E8ECF3; border-color: #2F3946; }
      .lp-cta .sk-btn-ghost:hover { background: #14181F; }
      .lp-meta { margin-top: var(--sp-6); font-size: var(--fs-sm); color: #69727F; display: flex; gap: var(--sp-5); flex-wrap: wrap; }
      .lp-meta strong { color: #A9B4C4; font-weight: 600; }

      .lp-demo { position: relative; margin: -56px auto 0; max-width: 760px; padding: 0 var(--sp-5) var(--sp-8); }
      .lp-termcard {
        background: var(--sk-code-bg); border: 1px solid var(--sk-border);
        border-radius: var(--r-lg); box-shadow: var(--sk-shadow-md); overflow: hidden;
      }
      .lp-termhead {
        display: flex; align-items: center; gap: 8px; padding: 10px var(--sp-4);
        background: var(--sk-surface); border-bottom: 1px solid var(--sk-border);
      }
      .lp-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--sk-border-strong); }
      .lp-termhead .lbl { margin-left: 8px; font-family: var(--sk-font-mono); font-size: var(--fs-xs); color: var(--sk-text-faint); }
      .lp-termbody { padding: var(--sp-4) var(--sp-5); font-family: var(--sk-font-mono); font-size: var(--fs-code); line-height: 1.75; color: var(--sk-text); overflow-x: auto; }
      .lp-termbody .pr { color: var(--sk-accent); }
      .lp-termbody .cm { color: var(--sk-text-faint); }
      .lp-termbody .ok { color: var(--sk-tip); }
      .lp-termbody .dim { color: var(--sk-text-muted); }

      .lp-section { padding: var(--sp-9) 0; }
      .lp-kicker { font-family: var(--sk-font-mono); font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sk-accent); margin-bottom: var(--sp-3); }
      .lp-h2 { font-family: var(--sk-font-display); font-weight: 600; font-size: 2rem; letter-spacing: -0.02em; margin: 0 0 var(--sp-3); }
      .lp-section-lead { font-size: 1.125rem; color: var(--sk-text-muted); max-width: 640px; margin: 0 0 var(--sp-7); }
      .lp-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
      .lp-card { padding: var(--sp-5); border: 1px solid var(--sk-border); border-radius: var(--r-lg); background: var(--sk-surface); }
      .lp-card .ci { width: 34px; height: 34px; border-radius: 9px; background: var(--sk-accent-soft); color: var(--sk-accent);
        display: inline-flex; align-items: center; justify-content: center; margin-bottom: var(--sp-3); }
      .lp-card .ci svg { width: 18px; height: 18px; }
      .lp-card h3 { font-family: var(--sk-font-display); font-weight: 600; font-size: 1.125rem; margin: 0 0 6px; }
      .lp-card p { margin: 0; color: var(--sk-text-muted); font-size: var(--fs-sm); line-height: 1.6; }

      .lp-strip { border-top: 1px solid var(--sk-border); border-bottom: 1px solid var(--sk-border); background: var(--sk-bg-subtle); }
      .lp-strip-inner { padding: var(--sp-6) 0; text-align: center; }
      .lp-strip .lb { font-size: var(--fs-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--sk-text-faint); margin-bottom: var(--sp-4); }
      .lp-logos { display: flex; gap: var(--sp-7); justify-content: center; flex-wrap: wrap; }
      .lp-logos a { font-family: var(--sk-font-display); font-weight: 600; font-size: 1.125rem; color: var(--sk-text-muted); }
      .lp-logos a:hover { color: var(--sk-text); text-decoration: none; }

      .lp-footer { padding: var(--sp-8) 0 var(--sp-7); }
      .lp-foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--sp-5); }
      .lp-foot-grid h4 { font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--sk-text-faint); margin: 0 0 var(--sp-3); font-weight: 600; }
      .lp-foot-grid ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
      .lp-foot-grid a { color: var(--sk-text-muted); font-size: var(--fs-sm); }
      .lp-foot-grid a:hover { color: var(--sk-text); text-decoration: none; }
      .lp-foot-bar { display: flex; justify-content: space-between; align-items: center; margin-top: var(--sp-7); padding-top: var(--sp-4); border-top: 1px solid var(--sk-border); color: var(--sk-text-faint); font-size: var(--fs-sm); flex-wrap: wrap; gap: var(--sp-3); }

      @media (max-width: 760px) {
        .lp-grid, .lp-foot-grid { grid-template-columns: 1fr; }
        .lp-h1 { font-size: 2.5rem; }
      }
    </style>

    <!-- top bar (dark, over the hero) -->
    <header class="sk-topbar lp-topbar">
      <a class="sk-brand" href="/">
        <span class="sk-mark" aria-hidden="true"></span>
        <span class="sk-wordmark">skier<span class="dot">.</span></span>
      </a>
      {{#if version}}<span class="sk-ver">v{{version}}</span>{{/if}}
      <div class="spacer"></div>
      <nav class="sk-topnav">
        <a href="/getting-started">Docs</a>
        <a href="/task-reference">Reference</a>
        <a href="/faq">FAQ</a>
      </nav>
      <a class="sk-btn sk-btn-primary" href="/getting-started" style="margin-left:8px">Get started</a>
    </header>

    <!-- HERO -->
    <section class="lp-hero">
      <div class="lp-wrap">
        <div class="lp-hero-inner">
          <div class="lp-eyebrow">Open source · MIT · Task-based SSG</div>
          <h1 class="lp-h1">Static sites,<br /><span class="carve">carved clean.</span></h1>
          <p class="lp-sub">Skier is a task-based static site generator. Compose a pipeline of
          small, predictable tasks — Markdown and data in, fast HTML out. No framework,
          no lock-in, no surprises.</p>
          <div class="lp-cta">
            <a class="sk-btn sk-btn-primary" href="/getting-started">Get started →</a>
            <a class="sk-btn sk-btn-ghost sk-btn-mono" href="https://www.npmjs.com/package/skier" target="_blank" rel="noopener">npm i --save-dev skier</a>
          </div>
          <div class="lp-meta">
            <span><strong>TypeScript</strong>-first</span>
            <span><strong>MIT</strong> licensed</span>
            <span><strong>&lt;10&nbsp;min</strong> to first build</span>
          </div>
        </div>
      </div>
    </section>

    <!-- floating terminal demo -->
    <div class="lp-demo">
      <div class="lp-termcard">
        <div class="lp-termhead">
          <span class="lp-dot"></span><span class="lp-dot"></span><span class="lp-dot"></span>
          <span class="lbl">skier build</span>
        </div>
        <div class="lp-termbody">
<span class="cm"># docs/*.md + site/pages/*.hbs  →  a static site in public/</span><br />
<span class="pr">$</span> npx skier<br />
<span class="dim">→ prepareOutputTask       public/ cleaned</span><br />
<span class="dim">→ bundleCssTask           docs.min.css written</span><br />
<span class="dim">→ generateNavDataTask     6 sections built</span><br />
<span class="dim">→ generateItemsTask       docs rendered · anchored · highlighted</span><br />
<span class="dim">→ generateSearchIndexTask search.json indexed</span><br />
<span class="ok">✓ build complete — public/ ready to deploy</span>
        </div>
      </div>
    </div>

    <!-- FEATURES -->
    <section class="lp-section">
      <div class="lp-wrap">
        <div class="lp-kicker">Why Skier</div>
        <h2 class="lp-h2">A build you can actually reason about.</h2>
        <p class="lp-section-lead">Every site is a pipeline of tasks with clear inputs and
        outputs. Read the list, know what happens. Nothing hidden, nothing magic.</p>
        <div class="lp-grid">
          <div class="lp-card">
            <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg></span>
            <h3>Composable pipeline</h3>
            <p>Declare an ordered list of tasks in <code>skier.tasks.mjs</code>. Each has typed
            inputs and outputs and composes with the next — predictable by design.</p>
          </div>
          <div class="lp-card">
            <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M8 9l3 3-3 3M13 15h4"/></svg></span>
            <h3>Markdown that ships</h3>
            <p>marked + highlight.js out of the box — heading anchors, copy-ready code blocks
            with filename chips, and note / tip / warning callouts.</p>
          </div>
          <div class="lp-card">
            <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg></span>
            <h3>Batteries included</h3>
            <p>Pagination, RSS feeds, sitemaps and a native client-side search index —
            first-class built-in tasks, not plugins you hunt for.</p>
          </div>
          <div class="lp-card">
            <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/></svg></span>
            <h3>Yours to extend</h3>
            <p>Need something bespoke? Author a custom task in a few lines — the same shape as
            every built-in. No plugin framework to learn.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BUILT WITH -->
    <div class="lp-strip">
      <div class="lp-wrap">
        <div class="lp-strip-inner">
          <div class="lb">Built with Skier</div>
          <div class="lp-logos">
            <a href="https://ripixel.co.uk" target="_blank" rel="noopener">ripixel.co.uk</a>
            <a href="https://fitglue.tech" target="_blank" rel="noopener">FitGlue</a>
            <a href="https://binghamsundayrunningclub.co.uk" target="_blank" rel="noopener">BSRC</a>
            <a href="/getting-started">these docs</a>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="lp-footer">
      <div class="lp-wrap">
        <div class="lp-foot-grid">
          <div>
            <a class="sk-brand" href="/">
              <span class="sk-mark" aria-hidden="true"></span>
              <span class="sk-wordmark">skier<span class="dot">.</span></span>
            </a>
            <p style="color:var(--sk-text-muted);font-size:var(--fs-sm);max-width:280px;margin-top:12px">
              The task-based static site generator. Open source, MIT licensed, and dogfooded —
              these docs are built with Skier.</p>
          </div>
          <div>
            <h4>Docs</h4>
            <ul>
              <li><a href="/getting-started">Getting Started</a></li>
              <li><a href="/configuration">Configuration</a></li>
              <li><a href="/custom-tasks">Custom Tasks</a></li>
            </ul>
          </div>
          <div>
            <h4>Reference</h4>
            <ul>
              <li><a href="/task-reference">Built-in tasks</a></li>
              <li><a href="/api-reference">API reference</a></li>
              <li><a href="/faq">FAQ</a></li>
            </ul>
          </div>
          <div>
            <h4>Project</h4>
            <ul>
              <li><a href="https://github.com/ripixel/skier" target="_blank" rel="noopener">GitHub</a></li>
              <li><a href="https://www.npmjs.com/package/skier" target="_blank" rel="noopener">npm</a></li>
              <li><a href="https://github.com/ripixel/skier/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a></li>
            </ul>
          </div>
        </div>
        <div class="lp-foot-bar">
          <span>&copy; {{year}} Ripixel · MIT licensed</span>
          <span class="sk-btn-mono" style="color:var(--sk-text-faint)">skier.ripixel.co.uk</span>
        </div>
      </div>
    </footer>
  </body>

</html>
