<header class="sk-topbar">
  <button class="sk-iconbtn sk-hamburger" id="menuBtn" type="button" aria-label="Open menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>

  <a class="sk-brand" href="/">
    <span class="sk-mark" aria-hidden="true"></span>
    <span class="sk-wordmark">skier<span class="dot">.</span></span>
  </a>
  {{#if version}}<span class="sk-ver">v{{version}}</span>{{/if}}

  <div class="spacer"></div>

  {{!-- Search trigger slot. Behaviour (overlay + client index) is wired by the
        A6 search UI against the merged generateSearchIndexTask index. --}}
  <button class="sk-search-trigger" id="searchBtn" type="button" aria-label="Search docs">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="7" /><path d="M21 21l-4-4" />
    </svg>
    <span class="label">Search docs…</span>
    <span class="sk-kbd">⌘K</span>
  </button>

  <nav class="sk-topnav">
    <a href="/getting-started">Guides</a>
    <a href="/task-reference">Reference</a>
    <a href="/faq">FAQ</a>
  </nav>

  <a class="sk-iconbtn" href="https://github.com/ripixel/skier" target="_blank" rel="noopener" aria-label="GitHub">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.04 10.04 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
    </svg>
  </a>

  <button class="sk-iconbtn" id="themeBtn" type="button" aria-label="Toggle theme">
    <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg class="ic-moon" viewBox="0 0 24 24" fill="currentColor" style="display:none" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
  </button>
</header>
